{
  admin 0.0.0.0:{{ caddy_admin_port }}
  auto_https prefer_wildcard
}

*.{{ domain }} {
  tls {
    issuer acme {
      dns cloudflare {{ cloudflare_api_token }}
      resolvers 1.1.1.1
      disable_http_challenge
      disable_tlsalpn_challenge
      preferred_chains smallest
    }
  }
}

(common_auth) {
  basic_auth {
    {{ admin_username }} {{ admin_password_hash }}
  }
}

sonarr.{{ domain }} {
  reverse_proxy sonarr:{{ sonarr_port }}
}
radarr.{{ domain }} {
  reverse_proxy radarr:{{ radarr_port }}
}
bazarr.{{ domain }} {
  reverse_proxy bazarr:{{ bazarr_port }}
}
qbittorrent.{{ domain }} {
  import common_auth
  reverse_proxy qbittorrent:{{ qbittorrent_port }}
}
sabnzbd.{{ domain }} {
  reverse_proxy sabnzbd:{{ sabnzbd_port }}
}
plex.{{ domain }} {
  reverse_proxy plex:{{ plex_port }}
}
overseerr.{{ domain }} {
  reverse_proxy overseerr:{{ overseerr_port }}
}
homeassistant.{{ domain }} {
  reverse_proxy homeassistant:{{ homeassistant_port }}
}
zwavejs.{{ domain }} {
  import common_auth
  reverse_proxy zwavejs:{{ zwavejs_port }}
}
homepage.{{ domain }} {
  reverse_proxy homepage:{{ homepage_port }}
}
cockpit.{{ domain }} {
    reverse_proxy https://{{ ansible_host }}:{{ cockpit_port }} {
        transport http {
            tls_insecure_skip_verify
        }
    }
}
ariang.{{ domain }} {
  @no_cookie {
    not header Cookie *visited=*
  }
  handle @no_cookie {
    header Set-Cookie "visited=true; Path=/; Max-Age=31536000"
    redir "https://ariang.{{ domain }}/#!/settings/rpc/set/https/aria2.{{ domain }}/443/jsonrpc/{{ aria2_secret | b64encode }}" 302
  }
  handle {
    reverse_proxy ariang:{{ ariang_port }}
  }
}
aria2.{{ domain }} {
  reverse_proxy aria2:{{ aria2_port }}
}
stash.{{ domain }} {
  reverse_proxy stash:{{ stash_port }}
}
stashvr.{{ domain }} {
  reverse_proxy stashvr:{{ stashvr_port }}
}
