[global]
   workgroup = SPUDNET
   server string = Samba Server %h
   log file = /var/log/samba/log.%m
   max log size = 1000

   bind interfaces only = no

   security = user
   encrypt passwords = yes
   obey pam restrictions = yes
   passwd program = /usr/bin/passwd %u
   map to guest = bad user

   # Use Linux passwords (PAM)
   passdb backend = tdbsam
   unix password sync = yes
   pam password change = yes

   usershare allow guests = no

   # Disable printing by default
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes

   # Improve performance with large files
   socket options = TCP_NODELAY IPTOS_LOWDELAY
   min receivefile size = 16384

   # Security features
   client min protocol = SMB2
   server min protocol = SMB2

   # Name resolution
   dns proxy = no
   name resolve order = host bcast

# Share definitions
{% for share in samba_shares %}
[{{ share.name }}]
   path = {{ share.path }}
   browsable = {{ 'yes' if share.browsable else 'no' }}
   guest ok = {{ 'yes' if share.guest_ok else 'no' }}
   read only = {{ 'yes' if share.read_only else 'no' }}
   create mask = {{ share.create_mask | default('0744') }}
   directory mask = {{ share.directory_mask | default('0755') }}
   {% if share.valid_users is defined %}
   valid users = {{ share.valid_users }}
   {% endif %}
   {% if share.write_list is defined %}
   write list = {{ share.write_list }}
   {% endif %}
   {% if share.comment is defined %}
   comment = {{ share.comment }}
   {% endif %}

{% endfor %}