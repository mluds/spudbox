services:
  sabnzbd:
    image: linuxserver/sabnzbd
    container_name: sabnzbd
    restart: unless-stopped
    user: "{{ sabnzbd_uid }}:{{ media_gid }}"
    ports:
      - "{{ sabnzbd_port }}:{{ sabnzbd_port }}"
    volumes:
      - /mnt/storage/appdata/sabnzbd:/config
      - /mnt/storage/data:/data
    environment:
      - PUID={{ sabnzbd_uid }}
      - PGID={{ media_gid }}
      - TZ=America/New_York
    networks:
      - internal

  radarr:
    image: linuxserver/radarr
    container_name: radarr
    restart: unless-stopped
    user: "{{ radarr_uid }}:{{ media_gid }}"
    ports:
      - "{{ radarr_port }}:{{ radarr_port }}"
    volumes:
      - /mnt/storage/appdata/radarr:/config
      - /mnt/storage/data:/data
    environment:
      - PUID={{ radarr_uid }}
      - PGID={{ media_gid }}
      - TZ=America/New_York
    networks:
      - internal

  sonarr:
    image: linuxserver/sonarr
    container_name: sonarr
    restart: unless-stopped
    user: "{{ sonarr_uid }}:{{ media_gid }}"
    ports:
      - "{{ sonarr_port }}:{{ sonarr_port }}"
    volumes:
      - /mnt/storage/appdata/sonarr:/config
      - /mnt/storage/data:/data
    environment:
      - PUID={{ sonarr_uid }}
      - PGID={{ media_gid }}
      - TZ=America/New_York
    networks:
      - internal

  plex:
    image: linuxserver/plex
    container_name: plex
    restart: unless-stopped
    ports:
      - "{{ plex_port }}:{{ plex_port }}"
    volumes:
      - /mnt/storage/appdata/plex:/config
      - /mnt/storage/data:/data
    environment:
      - PUID={{ plex_uid }}
      - PGID={{ media_gid }}
      - TZ=America/New_York
      - VERSION=docker
      - PLEX_CLAIM={{ plex_claim }}
    networks:
      - internal

  overseerr:
    image: linuxserver/overseerr
    container_name: overseerr
    restart: unless-stopped
    user: "{{ overseerr_uid }}:{{ overseerr_uid }}"
    ports:
      - "{{ overseerr_port }}:{{ overseerr_port }}"
    volumes:
      - /mnt/storage/appdata/overseerr:/config
    environment:
      - PUID={{ overseerr_uid }}
      - PGID={{ overseerr_uid }}
      - TZ=America/New_York
    networks:
      - internal

  qbittorrent:
    image: linuxserver/qbittorrent
    container_name: qbittorrent
    restart: unless-stopped
    user: "{{ qbittorrent_uid }}:{{ qbittorrent_uid }}"
    ports:
      - "{{ qbittorrent_port }}:{{ qbittorrent_port }}"
    volumes:
      - /mnt/storage/appdata/qbittorrent:/config
      - /mnt/storage/data:/data
    environment:
      - PUID={{ qbittorrent_uid }}
      - PGID={{ qbittorrent_uid }}
      - TZ=America/New_York
      - WEBUI_PORT={{ qbittorrent_port }}
    networks:
      - internal

