services:
  radarr:
    image: linuxserver/radarr
    container_name: radarr
    restart: unless-stopped
    ports:
      - "7878:7878"
    volumes:
      - /mnt/storage/appdata/radarr:/config
      - /mnt/storage/data/media/movies:/movies
    environment:
      - PUID={{ radarr_user }}
      - PGID={{ radarr_user }}
      - TZ=America/New_York
    networks:
      - internal

  sabnzbd:
    image: linuxserver/sabnzbd
    container_name: sabnzbd
    restart: unless-stopped
    ports:
      - "8082:8080"
    volumes:
      - /mnt/storage/appdata/sabnzbd:/config
      - /mnt/storage/data/usenet/complete:{{ sabnzbd_complete_dir }}
      - /mnt/storage/data/usenet/incomplete:{{ sabnzbd_download_dir }}
    environment:
      - PUID={{ sabnzbd_user }}
      - PGID={{ sabnzbd_user }}
      - TZ=America/New_York
    networks:
      - internal

