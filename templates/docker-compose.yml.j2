services:
  sabnzbd:
    image: linuxserver/sabnzbd
    container_name: sabnzbd
    restart: unless-stopped
    user: "{{ sabnzbd_uid }}:{{ media_gid }}"
    ports:
      - "{{ sabnzbd_port }}"
    volumes:
      - /mnt/storage/appdata/sabnzbd:/config
      - /mnt/storage/data:/data
    environment:
      - PUID={{ sabnzbd_uid }}
      - PGID={{ media_gid }}
      - TZ=America/New_York
    networks:
      - internal

  radarr:
    image: linuxserver/radarr
    container_name: radarr
    restart: unless-stopped
    user: "{{ radarr_uid }}:{{ media_gid }}"
    ports:
      # Needed to access API from Ansible
      - "127.0.0.1:{{ radarr_port }}:{{ radarr_port }}"
    volumes:
      - /mnt/storage/appdata/radarr:/config
      - /mnt/storage/data:/data
    environment:
      - PUID={{ radarr_uid }}
      - PGID={{ media_gid }}
      - TZ=America/New_York
    networks:
      - internal

  sonarr:
    image: linuxserver/sonarr
    container_name: sonarr
    restart: unless-stopped
    user: "{{ sonarr_uid }}:{{ media_gid }}"
    ports:
      # Needed to access API from Ansible
      - "127.0.0.1:{{ sonarr_port }}:{{ sonarr_port }}"
    volumes:
      - /mnt/storage/appdata/sonarr:/config
      - /mnt/storage/data:/data
    environment:
      - PUID={{ sonarr_uid }}
      - PGID={{ media_gid }}
      - TZ=America/New_York
    networks:
      - internal

  plex:
    image: linuxserver/plex
    container_name: plex
    restart: unless-stopped
    ports:
      - "{{ plex_port }}"
    volumes:
      - /mnt/storage/appdata/plex:/config
      - /mnt/storage/data:/data
    environment:
      - PUID={{ plex_uid }}
      - PGID={{ media_gid }}
      - TZ=America/New_York
      - VERSION=docker
      - PLEX_CLAIM={{ plex_claim }}
    networks:
      - internal

  overseerr:
    image: linuxserver/overseerr
    container_name: overseerr
    restart: unless-stopped
    user: "{{ overseerr_uid }}:{{ overseerr_uid }}"
    ports:
      - "{{ overseerr_port }}"
    volumes:
      - /mnt/storage/appdata/overseerr:/config
    environment:
      - PUID={{ overseerr_uid }}
      - PGID={{ overseerr_uid }}
      - TZ=America/New_York
    networks:
      - internal

  qbittorrent:
    image: linuxserver/qbittorrent
    container_name: qbittorrent
    restart: unless-stopped
    user: "{{ qbittorrent_uid }}:{{ media_gid }}"
    ports:
      - "{{ qbittorrent_port }}"
    volumes:
      - /mnt/storage/appdata/qbittorrent:/config
      - /mnt/storage/data:/data
    environment:
      - PUID={{ qbittorrent_uid }}
      - PGID={{ media_gid }}
      - TZ=America/New_York
      - WEBUI_PORT={{ qbittorrent_port }}
    networks:
      - internal

  caddy:
    build:
      context: .
      dockerfile: /mnt/storage/appdata/caddy/Dockerfile
    container_name: caddy
    restart: unless-stopped
    user: "{{ caddy_uid }}:{{ caddy_uid }}"
    cap_add:
      - NET_ADMIN
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - /mnt/storage/appdata/caddy/conf:/etc/caddy
      - /mnt/storage/appdata/caddy/data:/data
    networks:
      - internal

  homeassistant:
    container_name: homeassistant
    image: ghcr.io/home-assistant/home-assistant:stable
    user: "{{ homeassistant_uid }}:{{ homeassistant_uid }}"
    volumes:
      - /mnt/storage/appdata/homeassistant:/config
      - /etc/localtime:/etc/localtime:ro
    restart: unless-stopped
    ports:
      - "{{ homeassistant_port }}"
    networks:
      - internal

  zwavejs:
    container_name: zwavejs
    image: zwavejs/zwave-js-ui:latest
    restart: unless-stopped
    tty: true
    stop_signal: SIGINT
    # dialout group to access usb dongle
    user: "{{ zwavejs_uid }}:dialout"
    environment:
      - SESSION_SECRET={{ zwavejs_session_secret }}
      - TZ=America/New_York
    networks:
      - internal
    devices:
      - '{{ zwave_device_path }}:/dev/zwave'
    volumes:
      - /mnt/storage/appdata/zwavejs:/usr/src/app/store
    ports:
      - '{{ zwavejs_port }}'
      - '3000'

networks:
  internal:
    driver: bridge
