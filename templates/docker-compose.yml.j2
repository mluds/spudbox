services:
  sabnzbd:
    image: linuxserver/sabnzbd
    container_name: sabnzbd
    restart: unless-stopped
    user: "{{ sabnzbd_uid }}:{{ media_gid }}"
    ports:
      - "8082:8080"
    volumes:
      - /mnt/storage/appdata/sabnzbd:/config
      - /mnt/storage/data:/data
    environment:
      - PUID={{ sabnzbd_uid }}
      - PGID={{ media_gid }}
      - TZ=America/New_York
    networks:
      - internal

  radarr:
    image: linuxserver/radarr
    container_name: radarr
    restart: unless-stopped
    user: "{{ radarr_uid }}:{{ media_gid }}"
    ports:
      - "{{ radarr_port }}:{{ radarr_port }}"
    volumes:
      - /mnt/storage/appdata/radarr:/config
      - /mnt/storage/data:/data
    environment:
      - PUID={{ radarr_uid }}
      - PGID={{ media_gid }}
      - TZ=America/New_York
    networks:
      - internal

  sonarr:
    image: linuxserver/sonarr
    container_name: sonarr
    restart: unless-stopped
    user: "{{ sonarr_uid }}:{{ media_gid }}"
    ports:
      - "{{ sonarr_port }}:{{ sonarr_port }}"
    volumes:
      - /mnt/storage/appdata/sonarr:/config
      - /mnt/storage/data:/data
    environment:
      - PUID={{ sonarr_uid }}
      - PGID={{ media_gid }}
      - TZ=America/New_York
    networks:
      - internal

  plex:
    image: linuxserver/plex
    container_name: plex
    restart: unless-stopped
    user: "{{ plex_uid }}:{{ media_gid }}"
    ports:
      - "{{ plex_port }}:{{ plex_port }}"
    volumes:
      - /mnt/storage/appdata/plex:/config
      - /mnt/storage/data:/data
    environment:
      - PUID={{ plex_uid }}
      - PGID={{ media_gid }}
      - TZ=America/New_York
      - VERSION=docker
      - PLEX_CLAIM={{ plex_claim }}
    networks:
      - internal

