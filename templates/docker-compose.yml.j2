services:
  sabnzbd:
    image: linuxserver/sabnzbd
    container_name: sabnzbd
    restart: unless-stopped
    user: "{{ sabnzbd_uid }}:{{ media_gid }}"
    volumes:
      - "{{ appdata_dir }}/sabnzbd:/config"
      - "{{ cache_dir }}/data:/cache/data"
    environment:
      - PUID={{ sabnzbd_uid }}
      - PGID={{ media_gid }}
      - TZ=America/New_York
    networks:
      - internal

  radarr:
    image: linuxserver/radarr
    container_name: radarr
    restart: unless-stopped
    user: "{{ radarr_uid }}:{{ media_gid }}"
    ports:
      # Needed to access API from Ansible
      - "127.0.0.1:{{ radarr_port }}:{{ radarr_port }}"
    volumes:
      - "{{ appdata_dir }}/radarr:/config"
      - "{{ storage_dir }}/data:/storage/data"
      - "{{ cache_dir }}/data:/cache/data"
    environment:
      - PUID={{ radarr_uid }}
      - PGID={{ media_gid }}
      - TZ=America/New_York
    networks:
      - internal

  sonarr:
    image: linuxserver/sonarr
    container_name: sonarr
    restart: unless-stopped
    user: "{{ sonarr_uid }}:{{ media_gid }}"
    ports:
      # Needed to access API from Ansible
      - "127.0.0.1:{{ sonarr_port }}:{{ sonarr_port }}"
    volumes:
      - "{{ appdata_dir }}/sonarr:/config"
      - "{{ storage_dir }}/data:/storage/data"
      - "{{ cache_dir }}/data:/cache/data"
    environment:
      - PUID={{ sonarr_uid }}
      - PGID={{ media_gid }}
      - TZ=America/New_York
    networks:
      - internal

  bazarr:
    image: linuxserver/bazarr
    container_name: bazarr
    restart: unless-stopped
    user: "{{ bazarr_uid }}:{{ media_gid }}"
    ports:
      # Needed to access API from Ansible
      - "127.0.0.1:{{ bazarr_port }}:{{ bazarr_port }}"
    volumes:
      - "{{ appdata_dir }}/bazarr:/config"
      - "{{ storage_dir }}/data:/storage/data"
    environment:
      - PUID={{ bazarr_uid }}
      - PGID={{ media_gid }}
      - TZ=America/New_York
    networks:
      - internal

  plex:
    image: linuxserver/plex
    container_name: plex
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ plex_port }}:{{ plex_port }}"
    volumes:
      - "{{ appdata_dir }}/plex:/config"
      - "{{ storage_dir }}/data:/storage/data"
    environment:
      - PUID={{ plex_uid }}
      - PGID={{ media_gid }}
      - TZ=America/New_York
      - VERSION=docker
      - PLEX_CLAIM={{ plex_claim }}
    networks:
      - internal

  overseerr:
    image: linuxserver/overseerr
    container_name: overseerr
    restart: unless-stopped
    user: "{{ overseerr_uid }}:{{ overseerr_uid }}"
    volumes:
      - "{{ appdata_dir }}/overseerr:/config"
    environment:
      - PUID={{ overseerr_uid }}
      - PGID={{ overseerr_uid }}
      - TZ=America/New_York
    networks:
      - internal

  qbittorrent:
    image: linuxserver/qbittorrent
    container_name: qbittorrent
    restart: unless-stopped
    user: "{{ qbittorrent_uid }}:{{ media_gid }}"
    volumes:
      - "{{ appdata_dir }}/qbittorrent:/config"
      - "{{ storage_dir }}/data:/storage/data"
    environment:
      - PUID={{ qbittorrent_uid }}
      - PGID={{ media_gid }}
      - TZ=America/New_York
      - WEBUI_PORT={{ qbittorrent_port }}
    networks:
      - internal

  caddy:
    build:
      context: .
      dockerfile: "{{ appdata_dir }}/caddy/Dockerfile"
    container_name: caddy
    restart: unless-stopped
    user: "{{ caddy_uid }}:{{ caddy_uid }}"
    cap_add:
      - NET_ADMIN
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - "{{ appdata_dir }}/caddy/conf:/etc/caddy"
      - "{{ appdata_dir }}/caddy/data:/data"
    networks:
      - internal

  homeassistant:
    container_name: homeassistant
    image: ghcr.io/home-assistant/home-assistant:stable
    user: "{{ homeassistant_uid }}:{{ homeassistant_uid }}"
    volumes:
      - "{{ appdata_dir }}/homeassistant:/config"
      - /etc/localtime:/etc/localtime:ro
    restart: unless-stopped
    networks:
      - internal

{% if zwavejs_enabled %}
  zwavejs:
    container_name: zwavejs
    image: zwavejs/zwave-js-ui:latest
    restart: unless-stopped
    tty: true
    stop_signal: SIGINT
    # dialout group to access usb dongle
    user: "{{ zwavejs_uid }}:dialout"
    environment:
      - SESSION_SECRET={{ zwavejs_session_secret }}
      - TZ=America/New_York
    networks:
      - internal
    devices:
      - '{{ zwave_device_path }}:/dev/zwave'
    volumes:
      - "{{ appdata_dir }}/zwavejs:/usr/src/app/store"
    ports:
      - '{{ zwavejs_port }}'
      - '3000'
{% endif %}

  homepage:
    image: ghcr.io/gethomepage/homepage:latest
    container_name: homepage
    volumes:
      - "{{ appdata_dir }}/homepage:/app/config"
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - "{{ storage_dir }}:/data"
    environment:
      - PUID={{ homepage_uid }}
      - PGID={{ docker_gid }}
      - HOMEPAGE_ALLOWED_HOSTS=homepage.{{ domain }}
    restart: unless-stopped
    networks:
      - internal

  aria2:
    container_name: aria2
    image: p3terx/aria2-pro
    environment:
      - PUID={{ aria2_uid }}
      - PGID={{ media_gid }}
      - UMASK_SET=022
      - RPC_SECRET={{ aria2_secret }}
      - RPC_PORT={{ aria2_port }}
      - LISTEN_PORT=6888
      - DISK_CACHE=64M
      - IPV6_MODE=false
      - UPDATE_TRACKERS=false
      - CUSTOM_TRACKER_URL=
      - TZ=America/New_York
    volumes:
      - "{{ appdata_dir }}/aria2/config:/config"
      - "{{ cache_dir }}/data/downloads:/downloads"
    restart: unless-stopped
    networks:
      - internal

  ariang:
    image: p3terx/ariang
    container_name: ariang
    environment:
      - PUID={{ ariang_uid }}
      - PGID={{ ariang_uid }}
    restart: unless-stopped
    networks:
      - internal

  stash:
    image: stashapp/stash:latest
    container_name: stash
    restart: unless-stopped
    logging:
      driver: "json-file"
      options:
        max-file: "10"
        max-size: "2m"
    networks:
      - internal
    environment:
      - STASH_STASH=/data/
      - STASH_GENERATED=/generated/
      - STASH_METADATA=/metadata/
      - STASH_CACHE=/cache/
      - STASH_PORT={{ stash_port }}
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - "{{ storage_dir }}/data/misc:/data"
      - "{{ appdata_dir }}/stash/config:/root/.stash"
      - "{{ appdata_dir }}/stash/metadata:/metadata"
      - "{{ appdata_dir }}/stash/cache:/cache"
      - "{{ appdata_dir }}/stash/blobs:/blobs"
      - "{{ appdata_dir }}/stash/generated:/generated"

networks:
  internal:
    driver: bridge
