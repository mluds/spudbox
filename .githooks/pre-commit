#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
HOST="luds@192.168.1.42"
SSH_KEY="$HOME/.ssh/spudbox"

if ! ssh -i "$SSH_KEY" -o ConnectTimeout=5 "$HOST" "true" 2>/dev/null; then
  echo "pre-commit: server unreachable, skipping lint"
  exit 0
fi

echo "pre-commit: syncing and linting..."
rsync -az --delete --exclude='.git' -e "ssh -i $SSH_KEY" "$SCRIPT_DIR/" "$HOST:~/lint-check/"
ssh -i "$SSH_KEY" "$HOST" "cd ~/lint-check && bash lint.sh"
