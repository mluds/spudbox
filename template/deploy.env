# Read by deploy.sh.
# The server, as a superuser from spudbox.users (passwordless sudo).
HOST=alice@192.168.1.10
SSH_KEY=$HOME/.ssh/id_ed25519
# Extra ssh options, e.g. a non-standard port:
# SSH_OPTS="-p 2222"
# To deploy a local checkout of the spudbox module instead of the version
# pinned in flake.lock (when changing the module itself):
# SPUDBOX_SRC=$HOME/src/spudbox
