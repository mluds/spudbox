{
  config,
  lib,
  pkgs,
  ...
}:

# Secrets live in secretsDir (root-only). Three kinds:
#  - generated here, on first boot, if the instance didn't supply them: the
#    admin username, each web UI's password, the API keys Sonarr, Radarr and
#    SABnzbd are configured with, and the restic password. `sudo
#    spudbox-passwords` prints the logins.
#  - generated by the apps at runtime and exported by their *-config units
#    (the Plex token, Bazarr/Tautulli/Jellyseerr/Audiobookshelf keys).
#  - third-party accounts only the owner can supply (REQUIRED_SECRETS below),
#    deployed from the instance repo's secrets/ dir. spudbox-secrets warns
#    about any that are missing; test.sh fails on them.
let
  cfg = config.spudbox;
  inherit (cfg) secretsDir;

  passwordServices = config.spudbox.passwordServices;

  # file -> how to make it
  generated = {
    "admin/username" = "username";
    "sonarr/api-key" = "hex";
    "radarr/api-key" = "hex";
    "sabnzbd/api-key" = "hex";
    "sabnzbd/nzb-key" = "hex";
    "audiobookshelf/token-secret" = "password";
    "restic/password" = "password";
  }
  // lib.genAttrs (map (svc: "${svc}/password") passwordServices) (_: "password");

  required =
    lib.optionals (cfg.usenet.servers != [ ]) [
      "usenet/username"
      "usenet/password"
    ]
    ++ map (indexer: indexer.apiKeySecret) cfg.indexers
    ++ lib.optional (cfg.tls == "cloudflare") "cloudflare/api-token"
    ++ lib.optionals (lib.elem "opensubtitlescom" cfg.subtitleProviders) [
      "opensubtitles/username"
      "opensubtitles/password"
    ]
    ++ lib.optional (lib.elem "assrt" cfg.subtitleProviders) "assrt/api-token"
    ++ lib.optionals cfg.pushover.enable [
      "pushover/app-token"
      "pushover/user-key"
    ]
    ++ lib.optional cfg.offsiteBackup.enable "r2/s3-credentials.env";

  generateScript = pkgs.writeShellApplication {
    name = "spudbox-secrets";
    runtimeInputs = with pkgs; [ coreutils ];
    text = ''
      umask 077
      install -d -m 700 ${secretsDir}
      cd ${secretsDir}

      # generate FILE KIND: create FILE (no trailing newline) unless it has content
      generate() {
        [ -s "$1" ] && return
        mkdir -p "$(dirname "$1")"
        case $2 in
          username) printf admin ;;
          # 32 alphanumerics (~190 bits). cut reads all its input, so no
          # SIGPIPE under pipefail.
          password) head -c 1024 /dev/urandom | tr -dc 'A-Za-z0-9' | cut -c1-32 | tr -d '\n' ;;
          hex) od -An -tx1 -N16 /dev/urandom | tr -d ' \n' ;;
        esac > "$1"
        echo "Generated $1"
      }
      ${lib.concatLines (lib.mapAttrsToList (file: kind: "generate ${file} ${kind}") generated)}

      missing=0
      for file in ${toString required}; do
        if [ ! -s "$file" ]; then
          echo "MISSING: ${secretsDir}/$file (add it to the instance's secrets/ and deploy)"
          missing=1
        fi
      done
      [ "$missing" -eq 0 ] && echo "All required secrets present."
      exit 0
    '';
  };

  passwordsScript = pkgs.writeShellApplication {
    name = "spudbox-passwords";
    text = ''
      if [ "$(id -u)" -ne 0 ]; then
        exec sudo "$0" "$@"
      fi
      printf 'Username for every web UI: %s\n\n' "$(cat ${secretsDir}/admin/username)"
      for svc in ${toString passwordServices}; do
        printf '  %-16s https://%s.${cfg.domain}  %s\n' "$svc" "$svc" "$(cat "${secretsDir}/$svc/password")"
      done
    '';
  };
in
{
  options.spudbox.passwordServices = lib.mkOption {
    type = lib.types.listOf lib.types.str;
    internal = true;
    description = "Services with their own web login (secrets/<name>/password).";
  };

  config = {
    environment.systemPackages = [ passwordsScript ];

    # Before every ordinary service (they all start after basic.target), so
    # LoadCredential= and the *-config units find their files on first boot.
    systemd.services.spudbox-secrets = {
      description = "Generate missing spudbox secrets";
      wantedBy = [ "basic.target" ];
      before = [ "basic.target" ];
      after = [ "local-fs.target" ];
      unitConfig.DefaultDependencies = false;
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        ExecStart = lib.getExe generateScript;
      };
    };

    environment.etc."spudbox/env".text = lib.concatLines [
      (lib.toShellVar "REQUIRED_SECRETS" required)
      (lib.toShellVar "GENERATED_SECRETS" (lib.attrNames generated))
    ];
  };
}
